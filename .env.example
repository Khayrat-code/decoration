# ============================================================
# ToolCan Decoration — environment template
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored. Never commit it.
# ============================================================

# Supabase project URL (the one this repo was built against)
SUPABASE_URL=https://fpmjlkqiljfwbnnljptr.supabase.co

# Service-role key — bypasses RLS. Required by scripts/seed.mjs and
# scripts/upload-user-images.mjs. Found in Supabase → Settings → API.
# DO NOT commit the real value; load from .env on your machine.
SUPABASE_SERVICE_KEY=

# Optional — admin user created by scripts/seed.mjs
ADMIN_EMAIL=admin@toolcan.example
ADMIN_PASSWORD=ToolCan2026!
